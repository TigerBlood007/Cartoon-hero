# ── Wallet / chain ────────────────────────────────────────────────────────────
# Polygon private key for the wallet that signs CLOB orders. NEVER commit this.
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Proxy / funder wallet address that actually holds USDC.e (Polymarket proxy wallet).
POLYMARKET_PROXY_WALLET=0xYOUR_PROXY_WALLET_ADDRESS

# ── CLOB API credentials (generate via py-clob-client create_or_derive_api_creds) ──
CLOB_API_KEY=your-clob-api-key
CLOB_API_SECRET=your-clob-api-secret
CLOB_API_PASSPHRASE=your-clob-api-passphrase

# ── News API (https://newsapi.org — free tier is fine for Layer Three) ───────
NEWS_API_KEY=your-newsapi-key

# ── Safety ────────────────────────────────────────────────────────────────────
# Must be explicitly set to "false" to place real orders. Anything else = dry run.
DRY_RUN=true
